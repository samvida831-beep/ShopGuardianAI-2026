# ShopGuardian AI - Root Environment Template
# Copy this file to .env for local configuration

CAMERA_MODE=demo
ENTRY_RTSP_URL=rtsp://username:password@192.168.1.3:554/cam/realmonitor?channel=1&subtype=0
INSIDE_RTSP_URL=rtsp://username:password@192.168.1.3:554/cam/realmonitor?channel=2&subtype=0
CORS_ORIGINS=https://your-production-frontend.example.com

# Authentication
# Set to true ONLY for local demos to recreate the default admin account on an empty database.
SEED_DEMO_ADMIN=false
# REQUIRED in production: HMAC secret used to sign authentication tokens.
SHOPGUARDIAN_SECRET_KEY=change-me-to-a-long-random-string
